RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="Portrait Booth <booth@your-verified-domain.com>"
RESEND_TEMPLATE_ID="template_id"
RESEND_TEMPLATE_IMAGE_VARIABLE="PHOTO_IMAGE"
# Shared secret required on capture, preview, and email requests. Empty disables auth.
BOOTH_API_TOKEN=""
# Optional comma-separated CORS origins. Leave empty to allow any origin (the token protects the API).
FRONTEND_ORIGIN=""
PHOTO_STORAGE_DIR="data/images"
WATERMARK_IMAGE_PATH="backend/watermark.png"
# gphoto2 (USB camera, live preview) or ftp (camera uploads over the network; no live preview).
CAMERA_MODE="gphoto2"
# FTP mode settings. Enter the same user, password, and port in the camera's FTP transfer settings.
FTP_PORT=2121
FTP_USER="booth"
FTP_PASSWORD=""
FTP_PASSIVE_PORTS="60000-60010"
FTP_UPLOAD_DIR="data/ftp-incoming"
# Seconds a capture request waits for the camera to upload a photo.
FTP_CAPTURE_TIMEOUT=120
DEV_BYPASS=true
DEV_BYPASS_IMAGE="frontend/public/image.jpg"
NEON_DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/booth?sslmode=require"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT_URL=""
S3_PUBLIC_BASE_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""